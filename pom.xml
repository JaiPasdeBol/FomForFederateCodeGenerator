<?xml version="1.0" encoding="UTF-8"?>
<!--
  FomForFederateCodeGenerator : projet parent (agregateur) de deux modules.

    rprfom-runtime-api : interfaces Java PARTAGEES par tout le code genere et par les
                         couches qui l'utilisent (HLAbstract) : HLAObjectClass,
                         HLAInteractionClass, IHLAAttributeBase, IHLAParameterBase,
                         OwnershipState (package rprfom.api). Aucune dependance.
    rprfom-codegen     : le generateur (inchange pour l'utilisateur : memes coordonnees
                         Maven com.rprfom:rprfom-codegen:1.0.0, meme ligne de commande).

  Build et installation des deux modules :  mvn clean install   (a cette racine)
  Jar executable du generateur :            rprfom-codegen/target/rprfom-codegen.jar

  Les deux modules partagent la meme version : le code genere par une version du
  generateur depend de rprfom-runtime-api de la MEME version.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.rprfom</groupId>
    <artifactId>rprfom-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>rprfom-parent</name>

    <modules>
        <module>rprfom-runtime-api</module>
        <module>rprfom-codegen</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
